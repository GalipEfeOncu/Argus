{
  "name": "argus",
  "version": "1.0.0-alpha.2",
  "description": "A transparent, local-first multi-agent workspace for software projects.",
  "license": "Apache-2.0",
  "author": "Galip Efe Oncu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalipEfeOncu/Argus.git"
  },
  "homepage": "https://github.com/GalipEfeOncu/Argus#readme",
  "bugs": {
    "url": "https://github.com/GalipEfeOncu/Argus/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-offline-assets.mjs dist",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run sidecar:build && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "sidecar:build": "bash scripts/build-sidecar.sh",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:version": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "benchmark:fixtures": "node scripts/benchmarks/generate-fixtures.mjs",
    "benchmark:validate": "node scripts/benchmarks/benchmark.mjs validate",
    "benchmark:compare": "node scripts/benchmarks/benchmark.mjs compare",
    "benchmark:report": "node scripts/benchmarks/benchmark.mjs report",
    "benchmark:attribution": "node scripts/benchmarks/benchmark.mjs attribution",
    "benchmark:release": "node scripts/benchmarks/benchmark.mjs release",
    "test:benchmarks": "node --test scripts/benchmarks/test/*.test.mjs",
    "platform:quality": "node scripts/platform-quality.mjs",
    "test:platform-quality": "node --test scripts/platform-quality.test.mjs",
    "accessibility:quality": "node scripts/accessibility-quality.mjs",
    "test:accessibility-quality": "node --test scripts/accessibility-quality.test.mjs",
    "supply-chain:sbom": "python scripts/supply_chain.py sbom artifacts/argus.cdx.json",
    "supply-chain:licenses": "python scripts/supply_chain.py licenses artifacts/licenses.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^3.7.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
